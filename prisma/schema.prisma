// Package announcement chat. The legacy `ws_package_chat` was a stub (message
// only); extended 2026-06-13 with media/sender/push columns to match the Mongo
// PackageChat contract (see src/modules/package-chat).
model PackageChat {
  id         Int                 @id @default(autoincrement())
  packageId  Int                 @map("package_id")
