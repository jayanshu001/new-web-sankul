  // Computed by modules/plan-popularity (all-time paid orders). Read-only to the
  // API. The `most_popular_pinned` override column was dropped 2026-08-05.
  isMostPopular              Boolean                      @default(false) @map("is_most_popular")
  created_at                 DateTime?
  updated_at                 DateTime?
  packageCourseOrder         PackageCourseOrder[]
  packageCourseSubscription  PackageCourseSubscription[]
