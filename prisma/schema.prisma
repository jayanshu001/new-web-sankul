model Course {
  id                        Int                         @id @default(autoincrement())
  educator                  CourseEducator?             @relation(fields: [courseEducatorId], references: [id])
  courseEducatorId          Int?                        @map("educator_id")
  subject                   CourseSubjectCategory?      @relation(fields: [courseSubjectCategoryId], references: [id])
  courseSubjectCategoryId   Int?                        @map("course_category_id")
  VideoCategory             VideoCategory?              @relation(fields: [videoCategoryId], references: [id])
  videoCategoryId           Int?                        @map("vcategory_id")
  name                      String?
  image                     String?
  description               String
  ordered                   Int                         @map("order_by")
  shareableLink             String                      @map("shareable_link")
  withMaterial              String                      @map("with_material")
  withoutMaterial           String                      @map("without_material")
  material                  PackageCourseMaterial?      @relation(fields: [pcMaterialId], references: [id])
  pcMaterialId              Int?                        @map("pc_material_id")
  level                     String
  /// Business rule: a course is NEVER free. DB-side this column is NOT NULL
  /// DEFAULT '1' (2026-08-25_ws_course_purchase_always_paid.sql); it is left
  /// OPTIONAL here on purpose so this schema is valid both before and after that
  /// DDL lands on an environment. Tighten to non-nullable once it is applied
  /// everywhere.
  purchase                  CourseFlag01?               @default(yes) @map("purchase")
  is_featured               CourseFlag01?               @map("is_featured")
  status                    Boolean
  createdAt                 DateTime?                   @map("created_at")
  updatedAt                 DateTime?                   @map("updated_at")
  examCategoryCourse        ExamCategoryCourse[]
  materialCategoryCourse    MaterialCategoryCourse[]
  courseBook                CourseBook[]
  plans                     PackageCourseEbookPrice[]
  packageCourseSubscription PackageCourseSubscription[]
  examCountdownIds          Json? @map("exam_countdown_ids")
  examCountdownCategoryIds  Json? @map("exam_countdown_category_ids")

  @@map("ws_course")
}

