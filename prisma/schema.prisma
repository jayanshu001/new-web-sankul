// ─────────────────────────────────────────────────────────────────────────────
// Wave 6 — LiveCourse / LiveSession (created 2026-06-18; see
// docs/migration/schema-changes/2026-06-18_create_ws_live_course_tables.sql).
// Mirrors the live Mongo collections. Standalone models (no cross-relations to
// keep the additive change low-risk); ids surfaced as strings by the modules.
// ─────────────────────────────────────────────────────────────────────────────

model LiveCourse {
  id                       Int       @id @default(autoincrement())
  name                     String
  subtitle                 String?
  description              String?
  image                    String?
  ordered                  Int       @default(0)
  shareableLink            String?   @map("shareable_link")
  withMaterial             String?   @map("with_material")
  withoutMaterial          String?   @map("without_material")
  classType                String    @default("live") @map("class_type")
  status                   Boolean   @default(true)
  isPaid                   Boolean   @default(true) @map("is_paid")
  isPopular                Boolean   @default(false) @map("is_popular")
  educatorId               Int?      @map("educator_id")
  courseSubjectCategoryId  Int?      @map("course_subject_category_id")
  videoCategoryId          Int?      @map("video_category_id")
  packageCategoryId        Int?      @map("package_category_id")
  createdBy                Int?      @map("created_by")
  startTime                DateTime? @map("start_time")
  scheduleEntries          Json?     @map("schedule_entries")
  scheduleFolders          Json?     @map("schedule_folders")
  timetableFiles           Json?     @map("timetable_files")
  examCountdownCategoryIds Json?     @map("exam_countdown_category_ids")
  examCountdownIds         Json?     @map("exam_countdown_ids")
  materialCategories       Json?     @map("material_categories")
  examCategories           Json?     @map("exam_categories")
  createdAt                DateTime? @map("created_at")
  updatedAt                DateTime? @map("updated_at")

  @@map("ws_live_course")
}

model LiveCoursePlan {
  id            Int       @id @default(autoincrement())
  liveCourseId  Int       @map("live_course_id")
  name          String?
  duration      Int // ⚠ MONTHS (not DAYS) — see LIVE_COURSE_DESIGN §3
  price         Int
  originalPrice Int?      @map("original_price")
  // Per-plan material variant (mirrors PackageCourseEbookPrice.withMaterial):
  // withMaterial=true → plan ships physical material; materialPrice is the
  // material portion of the price (informational, like the course flow).
  withMaterial  Boolean   @default(false) @map("with_material")
  materialPrice Int?      @map("material_price")
  isDefault     Boolean   @default(false) @map("is_default")
  status        Boolean   @default(true)
  isMostPopular Boolean   @default(false) @map("is_most_popular") // computed; override col dropped 2026-08-05
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@map("ws_live_course_plan")
}

/// Live-course purchase record. Created at CHECKOUT (status "pending") and flipped
/// to "complete" at payment verify, at which point ONE LiveCourseSubscription row is
/// created for it. Renewals get their own order + their own subscription row — they
/// never fold onto the existing entitlement.
///
/// THE ORDER OWNS PAYMENT; THE SUBSCRIPTION OWNS ENTITLEMENT. Before 2026-08-25 live
/// course had no order table and the subscription carried both, which is why a
/// renewal had nowhere to record its own payment. Those columns still exist on
/// LiveCourseSubscription for pre-migration rows; new writes go here.
/// DDL: 2026-08-25_create_ws_live_course_order.sql
model LiveCourseOrder {
  id                Int       @id @default(autoincrement())
  customerId        Int       @map("customer_id")
  liveCourseId      Int       @map("live_course_id")
  planId            Int?      @map("plan_id")

  // Whole rupees (int, not Decimal) — matches ws_live_course_subscription, which
  // these columns were moved from. `originalAmount` is the pre-promo price and is
  // set ONLY when a promo was applied; that is what keeps the discount derivable
  // (liveSubDiscountAmount = original - paid - walletCoin).
  paidAmount        Int?      @map("paid_amount")
  originalAmount    Int?      @map("original_amount")
  walletCoin        Int?      @map("wallet_coin")

  // Frozen purchase-time snapshots, exactly one ever set (see modules/order-code-snapshot).
  promocode         Json?
  refferalcode      Json?

  paymentMethod     String?   @map("payment_method")
  razorpayOrderId   String?   @map("razorpay_order_id")
  razorpayPaymentId String?   @map("razorpay_payment_id")
  bankTransactionId String?   @map("bank_transaction_id")

  /// "pending" | "complete" | "failed" — ws_test_series_order vocabulary, NOT the
  /// subscription's "verified". The backfill maps verified → complete.
  status            String    @default("pending")
  paidAt            DateTime? @map("paid_at")

  // Chosen at checkout, before any subscription exists; copied onto the sub at verify.
  withMaterial       Boolean   @default(false) @map("with_material")
  customerShippingId Int?      @map("customer_shipping_id")

  remarks           String?
  createdAt         DateTime? @map("created_at")
  updatedAt         DateTime? @map("updated_at")
  created_by        Int?
  updated_by        Int?

  /// Normally exactly one — the entitlement this order paid for. A list, not a
  /// single row, only because Prisma models the inverse side of an optional FK that way.
  subscriptions     LiveCourseSubscription[]

  @@index([razorpayOrderId], name: "idx_lco_razorpay_order")
  @@index([customerId, liveCourseId], name: "idx_lco_customer_course")
  @@index([createdAt, status], name: "idx_lco_created_status")
  @@map("ws_live_course_order")
}

model LiveCourseSubscription {
  id                Int       @id @default(autoincrement())
  customerId        Int       @map("customer_id")
  liveCourseId      Int       @map("live_course_id")
  planId            Int?      @map("plan_id")
  // The order that paid for this row. NULL only on pre-2026-08-25 rows that the
  // backfill has not reached. DDL: 2026-08-25_create_ws_live_course_order.sql
  orderId           Int?      @map("order_id")
  /// Purchase history gates live rows on `order.status = "complete"` rather than the
  /// legacy `payment_status`, so an abandoned checkout never lists as a purchase.
  order             LiveCourseOrder? @relation(fields: [orderId], references: [id])
  startAt           DateTime? @map("start_at")
  endAt             DateTime? @map("end_at")
  status            Boolean   @default(true)
  // NO PAYMENT COLUMNS LIVE HERE. The order owns payment, the subscription owns
  // entitlement (2026-08-25). `promocode`/`refferalcode` snapshots, `wallet_coin`,
  // `original_amount`, `paid_amount`, `payment_status`, `payment_method`, the
  // razorpay/bank references and `paid_at` all moved to LiveCourseOrder and were
  // dropped from this table by
  // 2026-08-25_live_course_subscription_drop_payment_columns.sql.
  // Read them through `order`; there is no legacy fallback left to read.
  remarks           String?
  // Material fulfillment (lightweight, mirrors Mongo LiveCourseSubscription):
  // withMaterial marks a shipping order; customerShippingId is the chosen
  // delivery address (ws_customer_address.id).
  withMaterial       Boolean   @default(false) @map("with_material")
  customerShippingId Int?      @map("customer_shipping_id")
  // Shipment tracking for the material kit (mirrors ws_book_order.tracking_id +
  // ws_package_course_subscription.tracking). Unlike package/course there is no
  // separate live tracking table — the AWB + flat status live inline. Allocated at
  // payment-verify for with-material subs; trackingId is a synthetic AWB (below the
  // Tirupati threshold → generic trackingUrl), consistent with SQL book AWBs.
  trackingId         BigInt?   @map("tracking_id")
  trackingStatus     String?   @map("tracking_status")
  createdAt         DateTime? @map("created_at")
  updatedAt         DateTime? @map("updated_at")
  // Audit: acting admin on manual grant/edit (see subscription audit backend-request).
  created_by        Int?
  updated_by        Int?

  // Replaced idx_lcs_created_payment when payment_status was dropped — the admin
  // dashboard and the subscription reports still window on created_at.
  @@index([createdAt], name: "idx_lcs_created")
  @@map("ws_live_course_subscription")
}

model LiveSession {
  id                       Int       @id @default(autoincrement())
  title                    String?
  subject                  String?
  educatorId               Int?      @map("educator_id")
  scheduledAt              DateTime? @map("scheduled_at")
  endAt                    DateTime? @map("end_at")
  status                   String    @default("SCHEDULED")
  streamId                 String?   @map("stream_id")
  notifiedStreamId         String?   @map("notified_stream_id")
