}

// ****************************PACKAGE COURSE ORDER SUBSCRIPTION MODULE******************************

model PackageCourseOrder {
  id                                Int                                 @id @default(autoincrement())
  uniqueId                          String?                             @map("unique_id")
  Customer                          Customer?                           @relation(fields: [userId], references: [id])
  userId                            Int?                                @map("customer_id")
  orderType                         PackageCourseEbookOrderType         @map("order_type")
  PackageCourseEbookPrice           PackageCourseEbookPrice?            @relation(fields: [planId], references: [id])
  planId                            Int?                                @map("plan_id")
  // Dispatch address = ws_customer_shipping.id, NEVER a ws_customer_address.id.
  // The UIs hand over an address-book id; modules/customer-shipping snapshots it
  // into a shipping row and that id is what lands here. See the 2026-08-20 entry
  // in docs/MIGRATION_QUERY_CHANGES.md.
  CustomerShipping                  CustomerShipping?                   @relation(fields: [shipping], references: [id])
  shipping                          Int?                                @map("shipping")
  promocode                         Json?
  refferalcode                      Json?
  referrerId                        Int?                                @map("referrer_id")
  OrigianalPrice                    Int                                 @map("price")
  codeDiscount                      Int?                                @map("code_discount")
  wsCoin                            Int?                                @map("ws_coin")
  amount                            Int                                 @map("discount_price")
  paymentMethod                     PaymentMethod                       @map("payment_method")
  gatewayOrderId                    String?                             @map("razorpay_order_id")
  gatewayOrder                      String?                             @map("razorpay_order")
  gatewayPaymentId                  String?                             @map("razorpay_payment_id")
  bankTransactionId                 String?                             @map("bank_transaction_id")
  ip_address                        String?
  status                            PackageCourseEbookOrderStatus
  createdAt                         DateTime?                           @map("created_at")
  updatedAt                         DateTime?                           @map("updated_at")
  packageCourseSubscription         PackageCourseSubscription[]
  packageCourseSubscriptionTracking PackageCourseSubscriptionTracking[]
  RefferalTransaction               RefferalTransaction[]

  /// This table had NO index on customer_id — purchase-history scanned it whole, twice
  /// per request (list + count). DDL: 2026-08-26_purchase_history_indexes.sql
  @@index([userId, status, id], name: "idx_pco_user_status_id")
  @@map("ws_package_course_order")
}

model PackageCourseSubscription {
  id                                Int                                @id @default(autoincrement())
  customer                          Customer?                          @relation(fields: [customerId], references: [id])
  customerId                        Int?                               @map("customer_id")
  packageCourseOrder                PackageCourseOrder?                @relation(fields: [orderId], references: [id])
  orderId                           Int?                               @map("order_id")
  package                           Package?                           @relation(fields: [packageId], references: [id])
  packageId                         Int?                               @map("package_id")
  course                            Course?                            @relation(fields: [courseId], references: [id])
  courseId                          Int?                               @map("course_id")
  packageCourseEbookPrice           PackageCourseEbookPrice?           @relation(fields: [planId], references: [id])
  planId                            Int?                               @map("pcb_id")
  material                          PackageCourseMaterial?             @relation(fields: [pcMaterialId], references: [id])
  pcMaterialId                      Int?                               @map("pc_material_id")
  customerShipping                  CustomerShipping?                  @relation(fields: [shippingId], references: [id])
  shippingId                        Int?                               @map("shipping")
  packageCourseSubscriptionTracking PackageCourseSubscriptionTracking? @relation(fields: [trackingId], references: [id])
  trackingId                        BigInt?                            @map("tracking")
  startAt                           DateTime?                          @map("start_at")
  endAt                             DateTime?                          @map("end_at")
  amount                            Decimal?
  courseAmount                      Decimal?                           @map("course_amount")
  materialAmount                    Decimal?                           @map("material_amount")
  status                            Boolean
  payment_type                      PackageCourseEbookPaymentType
  remarks                           String?
  promoterId                        Int?                               @map("promoter_id")
  promoterPercentage                Decimal?                           @map("promoter_percentage")
  paidAmount                        Decimal?                           @map("paid_amount")
  created_by                        Int?
  updated_by                        Int?
  createdAt                         DateTime?                          @map("created_at")
  updatedAt                         DateTime?                          @map("updated_at")

  @@index([promoterId, createdAt], name: "idx_pcs_promoter")
  @@index([createdAt, courseId, amount], name: "idx_pcs_created_course_amount")
  @@index([customerId, status, endAt], name: "idx_pcs_customer_status_endat")
  // Package-detail Subscription tab: filter package_id, sort created_at DESC.
  @@index([packageId, createdAt], name: "idx_pcs_package_created")
  /// Purchase-history's order-less list + count (customer_id, status, order_id IS NULL).
  /// order_id must be IN the index or MySQL reads every matching row just to test it —
  /// that was ~16k row reads to return one number. Trailing `id` covers ORDER BY id DESC.
  /// Does NOT replace idx_pcs_customer_status_endat (that serves the end_at range reads).
  /// DDL: 2026-08-26_purchase_history_indexes.sql
  @@index([customerId, status, orderId, id], name: "idx_pcs_customer_status_order")
  @@map("ws_package_course_subscription")
}

model PackageCourseSubscriptionTracking {
  id                        BigInt                      @id @default(autoincrement())
  PackageCourseOrder        PackageCourseOrder?         @relation(fields: [orderId], references: [id])
  orderId                   Int?                        @map("order")
  status                    String
  created_at                DateTime?
  updated_at                DateTime?
  packageCourseSubscription PackageCourseSubscription[]

  /// Looked up by order id on every purchase-history page; the table had only a PK.
  /// The column is literally named `order`. DDL: 2026-08-26_purchase_history_indexes.sql
  @@index([orderId], name: "idx_pcst_order")
  @@map("ws_package_course_subscription_tracking")
}

