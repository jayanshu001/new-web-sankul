// ***************************ADMIN (ws_users)*********************
// Admin accounts. Laravel schema: snake_case columns, no `role`/`deleted`
// columns (roles come from the spatie pivots below). `status`/`is_dark` are
// stored as enum('0','1') in MySQL; mapped to Boolean via @db column type.
model AdminUser {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  firstName       String              @map("first_name") @db.VarChar(255)
  lastName        String?             @map("last_name") @db.VarChar(100)
  email           String              @unique @db.VarChar(255)
  image           String              @db.VarChar(255)
  emailVerifiedAt DateTime?           @map("email_verified_at")
  password        String              @db.VarChar(255)
  lastLoginDate   DateTime?           @map("last_login_date")
  lastLoginIp     String?             @map("last_login_ip") @db.VarChar(255)
  lastSeenAt      DateTime?           @map("last_seen_at")
  status          AdminStatusFlag     @default(active)
  rememberToken   String?             @map("remember_token") @db.VarChar(100)
  isDark          AdminDarkFlag       @default(light) @map("is_dark")
  createdAt       DateTime?           @map("created_at")
  updatedAt       DateTime?           @map("updated_at")
  accessTokens    AdminAccessToken[]

  @@map("ws_users")
}

// enum('0','1') columns from the legacy dump.
enum AdminStatusFlag {
  inactive @map("0")
  active   @map("1")
}

enum AdminDarkFlag {
  light @map("0")
  dark  @map("1")
}

model AdminAccessToken {
