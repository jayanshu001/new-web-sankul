  mediaUrl   String?             @map("media_url")
  mediaType  PackageChatMediaType? @map("media_type")
  senderType PackageChatSenderType @default(admin) @map("sender_type")
  senderId   String?             @map("sender_id") // admin ObjectId (admin auth stays Mongo)
  pushSent   Boolean             @default(false) @map("push_sent")
  createdAt  DateTime?           @map("created_at")
  updatedAt  DateTime?           @map("updated_at")

  @@map("ws_package_chat")
