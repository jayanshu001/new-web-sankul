  @@index([customerId, examId, status], map: "idx_exam_result_cust_exam_status")
  @@index([examId, status, customerId], map: "idx_exam_result_exam_status")
  @@map("ws_exam_result")
}

model ExamResultDetail {
  id                 Int                 @id @default(autoincrement()) @map("qresult_detail_id")
