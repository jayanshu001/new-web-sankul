// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Introspected from legacy websankul-api-staging; align with local dump via `yarn db:pull`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// *****************************ENUMS******************************

enum UpdateType {
  immediate
  flexible
}

enum BookLanguage {
  English
  Gujarati
  Hindi
}

enum BookOrderType {
  purchase
}

enum ExamType {
  daily
  subject
}

enum ExamResultType {
  true
  false
  skip
}

enum PaymentMethod {
  Backend
  razorpay
  bank
  cash
  free
  Paykun
  Paytm
}

enum EBookLanguage {
  English
  Gujarati
  Hindi
}

enum VideoType {
  free
  paid
}

// ws_course `is_featured` / `purchase` are MySQL enum('0','1'). Prisma enum
// identifiers cannot start with a digit, so the values are @map'd to '0'/'1'.
// The transformer converts these to the Mongo booleans isPopular / isPaid.
enum CourseFlag01 {
  no  @map("0")
  yes @map("1")
}

enum PackageCourseEbookOrderType {
  purchase
}

enum PackageCourseEbookOrderStatus {
  cancel
  complete
  pending
}

enum PackageCourseEbookPaymentType {
  backend
  online
}

enum PromocodeType {
  private
  public
}

enum RefferalTransactionType {
  credit
  debit
}

enum RefferalTransactionStatus {
  pending
  successful
  failed
}

enum OsType {
  android
  ios
}

enum Courses {
  UPSC
  GPSC
  STI
  DYSO
  RFO
  PI
  PSI
  Constable
  CCE
  Talati
  Forest
  TET_TAT
  FHW_MPHW
}

enum inquiryMode {
  online
  offline
}

// ****************************MODELS******************************

model AppUpdate {
  id               Int        @id @default(autoincrement())
  latestVersion    Int
  updateType       UpdateType @default(flexible)
  isUpdateAvailble Boolean

  @@map("ws_app_update")
}

model DynamicImage {
  id   Int    @id @default(autoincrement())
  logo String

  @@map("ws_dynamic_image")
}

model Department {
  id           Int                 @id @default(autoincrement())
  name         String
  decscription String
  order        Int
  active       Boolean
  contacts     DepartmentContact[]

  @@map("ws_department")
}

model DepartmentContact {
  id                  Int         @id @default(autoincrement())
  department          Int
  mobile              String      @db.VarChar(20)
  isCallAvailable     Boolean
  isWhatsAppAvailable Boolean
  order               Int
  active              Boolean
  DepartmentId        Department? @relation(fields: [department], references: [id])

  @@map("ws_department_contact")
}

model PopupNotifications {
  id              Int       @id @default(autoincrement())
  title           String
  description     String
  image           String
  discount        String
  promocode       String
  promo_expire_at DateTime
  status          Boolean
  created_at      DateTime?
  updated_at      DateTime?

  @@map("ws_popup_notification")
}

model FAQ {
  id         Int       @id @default(autoincrement())
  type       String    @map("type")
  question   String
  answer     String
  is_expand  Boolean
  created_at DateTime?
  updated_at DateTime?

  @@map("ws_faq")
}

model ImageNotification {
  id           Int     @id @default(autoincrement())
  image        String
  redirect_url String?
  active       Boolean

  @@map("ws_image_notification")
}

model TermsAndConditions {
  id Int @id @default(autoincrement())
  // MySQL enum('book','pendrive','referral code') — Prisma types it loosely as
  // String; writes MUST use an accepted value (see TERMS_MODULES) or MySQL rejects
  // the row with error 1265. UNIQUE because the client resolves a module with a
  // findFirst, so a second row would silently shadow the first.
  // DDL: docs/migration/schema-changes/2026-08-20_terms_module_unique.sql
  module                         String  @unique(map: "uq_terms_module")
  terms                          String
  // DEAD as of 2026-07-14: checkout reads the free-shipping threshold from
  // ws_book_setting (book-order.service). Kept only because the column is NOT NULL
  // and it still appears in TermsDto; nothing reads the value.
  freeShippingMinimumOrderAmount Int
  status                         Boolean

  @@map("ws_termsandcondition")
}

model Version {
  id                       Int @id @default(autoincrement())
  latestVersionCode        Int
  lastSupportedVersionCode Int

  @@map("ws_versions")
}

model BannerSlider {
  id         Int       @id @default(autoincrement())
  image      String    @db.VarChar(255)
  key        String?   @db.VarChar(255)
  keyId      Int?      @map("key_id") @db.Int
  orderBy    Int       @map("order_by")
  created_at DateTime?
  updated_at DateTime?

  @@map("ws_banner_slider")
}

// ****************************CUSTOMER MODULE******************************

model CustomerEducation {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(255)
  status   Boolean
  customer Customer[]

  @@map("ws_customer_education")
}

model CustomerState {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  state_code       String             @db.VarChar(255)
  active           Boolean
  distict          CustomerDistict[]
  customer         Customer[]
  customerAddress  CustomerAddress[]
  CustomerShipping CustomerShipping[]
  offlineCity      OfflineCity[]

  @@map("ws_customer_state")
}

model CustomerDistict {
  id       Int           @id @default(autoincrement())
  name     String        @db.VarChar(255)
  state    CustomerState @relation(references: [id], fields: [stateId])
  stateId  Int           @map("state")
  active   Boolean
  customer Customer[]

  @@map("ws_customer_distict")
}

model CustomerTargetGoal {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(255)
  image   String
  active  Boolean
  labels  Json?
  //customer   Customer[]
  Package Package[]

  @@map("ws_customer_target_goal")
}

model Customer {
  id                        Int                         @id @default(autoincrement())
  fullName                  String?                     @map("full_name") @db.VarChar(255)
  // Uniqueness is enforced DB-side only among ACTIVE rows via the generated
  // `phone_active` column + uq_customer_phone_active index (see
  // docs/migration/schema-changes/2026-06-27_customer_phone_active_unique.sql).
  // A soft-deleted phone may sign up again as a new row, so this is NOT @unique.
  phoneNumber               String                      @map("phone") @db.VarChar(11)
  emailAddress              String?                     @map("email_address") @db.VarChar(255)
  password                  String?                     @db.VarChar(255)
  isPhoneVerified           Boolean                     @map("is_phone_verified")
  otp                       String?                     @db.VarChar(4)
  otp_expires_at            DateTime?
  triedOtp                  Int                         @map("tried_otp") @db.Int
  otpBlockedAt              DateTime?                   @map("otp_blocked_at")
  profile_picture           String?                     @db.VarChar(255)
  phoneNumber2              String?                     @map("phone_2") @db.VarChar(11)
  birthDate                 DateTime?                   @map("dob") @db.Date
  gender                    String?                     @map("gender") @db.VarChar(10)
  state                     CustomerState?              @relation(references: [id], fields: [stateId])
  stateId                   Int?                        @map("state")
  district                  CustomerDistict?            @relation(references: [id], fields: [districtId])
  districtId                Int?                        @map("district")
  city                      String?                     @db.VarChar(255)
  education                 CustomerEducation?          @relation(references: [id], fields: [educationId])
  educationId               Int?                        @map("education_id") @db.Int
  language                  String?                     @db.VarChar(50)
  goal                      Json?                       @db.Json
  //goalIds             CustomerTargetGoal    @relation(references: [id], fields: [goal])
  referralCode              String?                     @map("referral_code")
  rewardPoints              Int?                        @map("reward_points")
  verified                  Boolean
  // Legacy FB-login id. Currently "0" for all rows; mapped read-only (no FB
  // write path exists). Default "0" matches the dump's column default.
  facebookId                String?                     @default("0") @map("facebook_id") @db.VarChar(255)
  firebaseToken             String?                     @map("device") @db.Text
  // AES-256 key (64 hex chars) the mobile app uses to encrypt/decrypt its
  // offline downloads (`.wsenc`). Generated ONCE per user by the app and parked
  // here so it survives logout / reinstall. SECRET — same handling class as
  // `password` / `otp`: never log it, never put it in a DTO, and only ever
  // return it to the authenticated owner via /client/downloads/encryption-key.
  // NULL = this user has never stored a key (the API's documented 404 state).
  downloadKeyHex            String?                     @map("download_key_hex") @db.VarChar(64)
  // Notification read watermark: every notification created at or BEFORE this instant
  // counts as read for this customer, without a per-row mark. Powers O(1)
  // mark-all-read and suppressed the cutover badge storm when read state moved off the
  // shared ws_notification.is_read. NULL = nothing pre-read (all new customers — the
  // signup cut-off already hides pre-signup broadcasts, so they need no stamp).
  notificationsReadBefore   DateTime?                   @map("notifications_read_before")
  os_type                   OsType                      @default(android)
  lastLogin                 DateTime?                   @map("last_login_date")
  lastLoginIp               String?                     @map("last_login_ip") @db.VarChar(255)
  lastLoginCount            Int?                        @map("login_count") @db.Int
  isLoggedIn                Boolean?                    @map("is_login")
  isAccountDeleted          Boolean                     @default(false) @map("is_account_deleted")
  status                    Boolean                     @default(true)
  createdAt                 DateTime?                   @map("created_at")
  updatedAt                 DateTime?                   @map("updated_at")
  customerOtp               CustomerOtp[]
  customerAccessToken       CustomerAccessToken[]
  customerAddress           CustomerAddress[]
  CustomerShipping          CustomerShipping[]
  bookCart                  BookCart[]
  bookOrder                 BookOrder[]
  examResultDetail          ExamResultDetail[]
  examResult                ExamResult[]
  examResultDetailAnalytics ExamResultDetailAnalytics[]
  packageCourseOrder        PackageCourseOrder[]
  packageCourseSubscription PackageCourseSubscription[]
  EBookOrder                EBookOrder[]
  EBookSubscription         EBookSubscription[]
  OfflineEnquiry            OfflineEnquiry[]
  CustomerBankAccount       CustomerBankAccount[]
  RefferalTransaction       RefferalTransaction[]

  @@map("ws_customer")
}

model CustomerOtp {
  id         Int       @id @default(autoincrement())
  customer   Customer  @relation(references: [id], fields: [customerId])
  customerId Int       @map("customer_id")
  otp        String    @db.VarChar(4)
  created_at DateTime?

  @@map("ws_customer_otp")
}

model CustomerAccessToken {
  id           Int      @id @default(autoincrement())
  customer     Customer @relation(references: [id], fields: [customerId])
  customerId   Int      @map("customer_id")
  token        String   @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  active       Boolean
  deleted      Boolean
  created_at   DateTime
  expires_at   DateTime

  // Backs the per-request liveness probe in authenticate.ts, the refresh-flow
  // lookup, and the is_login anti-join. Equality columns first, range last.
  // DDL: docs/migration/schema-changes/2026-08-25_customer_access_token_customer_index.sql
  @@index([customerId, active, deleted, expires_at], map: "idx_cust_access_token_live")
  @@map("ws_customer_access_token")
}

model CustomerAddress {
  id              Int            @id @default(autoincrement())
  name            String         @db.VarChar(50)
  phone           BigInt
  alternate_phone BigInt?
  email           String         @db.VarChar(100)
  address         String         @db.VarChar(255)
  address_2       String         @db.VarChar(255)
  city            String         @db.VarChar(20)
  State           CustomerState? @relation(fields: [state], references: [id])
  state           Int?           @map("state")
  pincode         Int
  label           String?        @db.VarChar(20)
  isDefault       Boolean?       @default(false) @map("is_default")
  customer        Customer?      @relation(fields: [userId], references: [id])
  userId          Int?           @map("user_id")
  status          Boolean?
  created_at      DateTime?
  updated_at      DateTime?

  @@map("ws_customer_address")
}

model CustomerShipping {
  id                        Int                         @id @default(autoincrement())
  name                      String                      @db.VarChar(50)
  phone                     BigInt
  alternate_phone           BigInt?
  email                     String                      @db.VarChar(100)
  address                   String                      @db.VarChar(255)
  address_2                 String                      @db.VarChar(255)
  city                      String                      @db.VarChar(20)
  State                     CustomerState?              @relation(fields: [state], references: [id])
  state                     Int?                        @map("state")
  pincode                   Int
  customer                  Customer?                   @relation(fields: [userId], references: [id])
  userId                    Int?                        @map("user_id")
  status                    Boolean?
  created_at                DateTime?
  updated_at                DateTime?
  bookCart                  BookCart[]
  bookOrder                 BookOrder[]
  packageCourseOrder        PackageCourseOrder[]
  packageCourseSubscription PackageCourseSubscription[]

  @@map("ws_customer_shipping")
}

model CustomerBankAccount {
  id                Int       @id @default(autoincrement()) @map("id")
  customerId        Int       @map("customer_id")
  customer          Customer? @relation(fields: [customerId], references: [id])
  accountHolderName String    @map("account_holder_name") @db.VarChar(150)
  ifscCode          String    @map("ifsc_code") @db.VarChar(50)
  accountNumber     String    @map("account_number")
  bankName          String?   @map("bank_name") @db.VarChar(150)
  branchName        String?   @map("branch_name") @db.VarChar(200)
  city              String?   @db.VarChar(100)
  createdAt         DateTime? @map("created_at")
  updatedAt         DateTime? @map("updated_at")

  @@map("ws_customer_bank_account")
}

// ****************************REFFERAL PROGRAM MODULE******************************

model PdfUploadJob {
  id            Int       @id @default(autoincrement())
  batchId       String    @map("batch_id") @db.VarChar(100)
  idx           Int       @default(0)
  uploadedBy    Int?      @map("uploaded_by")
  ebookId       Int?      @map("ebook_id")
  targetField   String    @default("bookUrl") @map("target_field") @db.VarChar(20)
  fileName      String    @map("file_name") @db.VarChar(500)
  tempPath      String    @map("temp_path") @db.VarChar(1000)
  fileSize      BigInt    @default(0) @map("file_size")
  status        String    @default("queued") @db.VarChar(20)
  progress      Int       @default(0)
  fileUrl       String?   @map("file_url") @db.VarChar(1000)
  failureReason String?   @map("failure_reason") @db.VarChar(1000)
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@index([batchId, idx], name: "idx_pdf_job_batch")
  @@index([status], name: "idx_pdf_job_status")
  @@map("ws_pdf_upload_job")
}

// Async report-export jobs (generic). A BullMQ worker builds the CSV/XLSX
// off-request and uploads it to Spaces (private); poll endpoint signs a GET URL.
model ExportJob {
  id          Int       @id @default(autoincrement())
  jobRef      String    @unique(map: "uq_export_job_ref") @map("job_ref") @db.VarChar(40)
  type        String    @db.VarChar(40)
  format      String    @default("excel") @db.VarChar(10)
  params      Json?
  status      String    @default("pending") @db.VarChar(20)
  progress    Int       @default(0)
  rowCount    Int?      @map("row_count")
  fileKey     String?   @map("file_key") @db.VarChar(512)
  fileName    String?   @map("file_name") @db.VarChar(255)
  error       String?   @db.VarChar(1000)
  requestedBy Int?      @map("requested_by")
  expiresAt   DateTime? @map("expires_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@index([status], name: "idx_export_job_status")
  @@index([requestedBy, createdAt], name: "idx_export_job_requester")
  @@map("ws_export_job")
}

model RefferalTerm {
  id        Int       @id @default(autoincrement())
  text      String    @db.VarChar(1000)
  orderBy   Int       @default(0) @map("order_by")
  status    Boolean   @default(true)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@index([status, orderBy], name: "idx_refferal_term_status_order")
  @@map("ws_refferal_term")
}

model RefferalFaq {
  id        Int       @id @default(autoincrement())
  question  String    @db.VarChar(500)
  answer    String    @db.Text
  orderBy   Int       @default(0) @map("order_by")
  status    Boolean   @default(true)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@index([status, orderBy], name: "idx_refferal_faq_status_order")
  @@map("ws_refferal_faq")
}

model RefferalProgram {
  id                  Int      @id @default(autoincrement()) @map("id")
  name                String   @map("name") @db.VarChar(50)
  title               String   @map("title")
  image               String   @map("image")
  refferalDiscount    Decimal  @map("refferal_discount")
  refferalReward      Decimal  @map("refferal_reward")
  minimumPrice        Int      @map("minimum_price")
  initialRewardAmount Int      @map("initial_reward_amount")
  video               String   @map("video") @db.VarChar(100)
  status              Boolean? @map("status")

  @@map("ws_refferal_program")
}

model RefferalTransaction {
  id          Int                       @id @default(autoincrement()) @map("id")
  orderId     Int?                      @map("order_id")
  source      String?                   @map("source") @db.VarChar(20)
  order       PackageCourseOrder?       @relation(fields: [orderId], references: [id])
  customerId  Int                       @map("customer_id")
  customer    Customer?                 @relation(fields: [customerId], references: [id])
  bankAccount Json?                     @map("bank_account")
  description String                    @map("description") @db.VarChar(150)
  coin        Int                       @map("coin")
  type        RefferalTransactionType   @map("type")
  status      RefferalTransactionStatus @map("status")
  providerRef String?                   @map("provider_ref") @db.VarChar(255)
  failureReason String?                 @map("failure_reason") @db.VarChar(500)
  createdAt   DateTime?                 @map("created_at")
  updatedAt   DateTime?                 @map("updated_at")

  @@map("ws_refferal_transaction")
}

// ****************************BOOK MODULE******************************

model Book {
  id               Int             @id @default(autoincrement())
  name             String
  thumbnail        String?
  author           String?
  image            String?
  description      String?
  // Per-book T&C, mirroring `ws_ebook.terms_and_conditions`. Nullable here because
  // it was added to an existing table (2026-08-18); the DTO coerces null → "" so the
  // client shape matches the ebook's non-null string.
  termsAndConditions String?       @map("terms_and_conditions") @db.Text
  demo_url         String?
  demoFileName     String?         @map("demo_file_name")
  weight           Int?
  pages            Int?
  dynamic_link     String?
  list_price       Int
  discounted_price Int
  isTrending       Boolean         @default(false) @map("is_trending")
  shipping_price   Int
  order_by         Int?
  language         String          @default("Gujarati")
  is_magazine      Boolean         @default(false)
  isCombo          Boolean         @default(false) @map("is_combo")
  active           Boolean         @default(true) @map("status")
  created_at       DateTime?
  updated_at       DateTime?
  bookCartItem     BookCartItem[]
  bookOrderItem    BookOrderItem[]
  courseBook       CourseBook[]
  examCountdownIds         Json? @map("exam_countdown_ids")
  examCountdownCategoryIds Json? @map("exam_countdown_category_ids")

  @@map("ws_book")
}

model BookSetting {
  id                         Int       @id @default(autoincrement())
  settingKey                 String    @unique @map("setting_key")
  freeShippingMinOrderAmount Float     @map("free_shipping_min_order_amount")
  supportPhone               String?   @map("support_phone")
  termsAndConditions         Json?     @map("terms_and_conditions")
  gstRate                    Float     @map("gst_rate")
  createdAt                  DateTime? @map("created_at")
  updatedAt                  DateTime? @map("updated_at")

  @@map("ws_book_setting")
}

model BookCart {
  id               Int               @id @default(autoincrement())
  cart_id          String
  userIpAddress    String?           @map("user_ip_address") @db.VarChar(50)
  Customer         Customer?         @relation(fields: [userId], references: [id])
  userId           Int?              @map("user_id")
  CustomerShipping CustomerShipping? @relation(fields: [shippingId], references: [id])
  shippingId       Int?              @map("shipping_id")
  active           Boolean           @map("status")
  created_at       DateTime?
  updated_at       DateTime?         @map("last_update")
  bookCartItem     BookCartItem[]

  @@map("ws_book_cart")
}

model BookCartItem {
  id       Int       @id @default(autoincrement())
  bookCart BookCart? @relation(fields: [cartId], references: [id])
  cartId   Int?      @map("cartid")
  book     Book?     @relation(fields: [bookId], references: [id])
  bookId   Int?      @map("item_id")
  qty      Int

  @@map("ws_book_cart_item")
}

model BookTracking {
  // tracking_id is BIGINT in the DDL (the courier AWB, ~1.19e11 — overflows
  // Int32). Mapped Int would THROW on every read. BigInt; surfaced as number.
  tracking_id BigInt      @id @default(autoincrement())
  orderId     String      @map("order_id")
  status      String
  createdAt   DateTime?   @map("created_at")
  updatedAt   DateTime?   @map("last_update")
  bookOrder   BookOrder[]

  @@map("ws_book_tracking")
}

model BookOrder {
  id               Int               @id @default(autoincrement())
  receiptId        String            @map("order_id")
  user             Customer?         @relation(fields: [userId], references: [id])
  userId           Int?              @map("customer_id")
  userIp           String?           @map("user_ip")
  cartId           String            @map("cart_id")
  shipping         CustomerShipping? @relation(fields: [shippingId], references: [id])
  shippingId       Int?              @map("shipping_id")
  BookTracking     BookTracking?     @relation(fields: [trackingId], references: [tracking_id])
  trackingId       BigInt?           @map("tracking_id") // BIGINT AWB (see BookTracking)
  orderType        BookOrderType     @map("order_type")
  orderItems       String            @map("order_items")
  paymentMethod    PaymentMethod     @map("payment_method")
  amount           Decimal           @map("order_price")
  gatewayOrderId   String            @map("gateway_order_id")
  gatewayOrder     String            @map("razorpay_order")
  gatewayPaymentId String?           @map("gateway_transaction_id")
  orderDate        DateTime?         @map("order_date")
  status           String
  paidAt           DateTime?         @map("paid_at")
  createdAt        DateTime?         @map("created_at")
  updatedAt        DateTime?         @map("updated_at")

  @@index([createdAt, status], name: "idx_book_order_created_status")
  @@map("ws_book_order")
}

model BookOrderItem {
  id             Int       @id @default(autoincrement())
  order_id       String
  Book           Book?     @relation(fields: [bookId], references: [id])
  bookId         Int?      @map("book_id")
  list_price     Int
  qty            Int
  price          Int
  shipping_price Int
  created_at     DateTime?
  updated_at     DateTime?

  @@map("ws_book_order_item")
}

// PENDRIVE MODULE removed 2026-07-08 — product line retired; all 7
// ws_pendrive_course* tables dropped (see
// docs/migration/schema-changes/2026-07-08_drop_pendrive_course.sql).

// ****************************EXAM MODULE******************************

model ExamCategory {
  id                  Int                   @id @default(autoincrement())
  name                String?
  image               String?
  parent              Int                   @map("parent_id")
  status              Boolean
  order_by            Int
  deleted             Boolean
  created_at          DateTime?
  updated_at          DateTime?
  exam                Exam[]
  examCategoryPackage ExamCategoryPackage[]
  examCategoryCourse  ExamCategoryCourse[]
  examCategoryPivot   ExamCategoryPivot[]

  @@map("ws_exam_category")
}

model Exam {
  id                Int                @id @default(autoincrement())
  name              String             @map("title")
  description       String?
  type              ExamType
  ExamCategory      ExamCategory?      @relation(fields: [examCategoryId], references: [id])
  examCategoryId    Int?               @map("exam_category_id")
  isPaid            Boolean            @map("is_paid")
  time              Int
  numberOfQuestions Int                @map("questions")
  positiveMarks     Decimal            @map("positive_marks")
  negativeMarks     Decimal            @map("negative_marks")
  solution          String?            @map("solution_pdf")
  solutionName      String?            @map("solution_pdf_name")
  startAt           DateTime?          @map("start_date")
  endAt             DateTime?          @map("end_date")
  status            Boolean
  order_by          Int
  send_push         Boolean
  createAt          DateTime?          @map("created_at")
  updatedAt         DateTime?          @map("updated_at")
  examQuestion      ExamQuestion[]
  examResultDetail  ExamResultDetail[]
  examResult        ExamResult[]
  examCategoryPivot ExamCategoryPivot[]

  @@map("ws_exam")
}

model ExamCategoryPivot {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  examId     Int          @map("exam_id")
  categoryId Int          @map("category_id")
  created_at DateTime?
  updated_at DateTime?
  Exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  Category   ExamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([examId, categoryId], map: "ws_exam_category_pivot_exam_id_category_id_unique")
  @@index([categoryId, examId], map: "ws_exam_category_pivot_category_id_exam_id_index")
