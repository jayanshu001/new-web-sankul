model PackageCourseEbookPrice {
  id                         Int                          @id @default(autoincrement())
  Package                    Package?                     @relation(fields: [packageId], references: [id])
  packageId                  Int?                         @map("package_id")
  Course                     Course?                      @relation(fields: [courseId], references: [id])
  courseId                   Int?                         @map("course_id")
  EBook                      EBook?                       @relation(fields: [ebookId], references: [id])
  ebookId                    Int?                         @map("ebook_id")
  name                       String?
  duration                   Int
  price                      Int
  withMaterial               Boolean                      @map("with_material")
  materialPrice              Int?                         @map("material_price")
  isDefault                  Boolean                      @map("is_default")
