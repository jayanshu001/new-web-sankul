// Layer-2 enrollment "last watched" pointer (see docs/be-dashboard-resume-scope.md).
// LectureProgress is unique per (customer, video) — a GLOBAL video-position store —
// so a lecture shared by a course AND a package can hold only ONE last-watched
// timestamp, which made the two resume cards mirror each other. This table keeps a
// SEPARATE last-watched pointer per (customer, scope_kind, scope_id) so each
// enrollment remembers its own last lecture. Position/duration are still read from
// LectureProgress (global); only the resume pointer is enrollment-scoped.
model EnrollmentResume {
  id            Int       @id @default(autoincrement())
  customerId    Int       @map("customer_id")
  scopeKind     String    @map("scope_kind") // "course" | "package" | "liveCourse"
  scopeId       Int       @map("scope_id")
  videoId       Int?      @map("video_id")
  liveSessionId Int?      @map("live_session_id")
  lastWatchedAt DateTime? @map("last_watched_at")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@unique([customerId, scopeKind, scopeId], name: "uniq_customer_scope")
  @@map("ws_enrollment_resume")
}

