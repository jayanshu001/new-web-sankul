PORT=4001

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-to-at-least-32-characters-long
JWT_ADMIN_TTL=24h

# ─── Media tokens (client media access; all OPTIONAL, sensible defaults) ──────
# Dedicated secret for short-lived media tokens (POST /client/media/resolve).
# Falls back to a value derived from JWT_ACCESS_SECRET when unset.
MEDIA_TOKEN_SECRET=
MEDIA_TOKEN_TTL_SECONDS=300          # media-token lifetime (default 5 min)
PREVIEW_TRACKING_SECRET=             # optional; HMAC key for previewTrackingId. Falls back to MEDIA_TOKEN_SECRET, then JWT_ACCESS_SECRET.
                                     # Changing it invalidates in-flight tracking ids (clients just re-join) — it does NOT reset anyone's consumed preview time.
MEDIA_SIGNED_URL_TTL_SECONDS=300     # presigned PDF/audio URL lifetime (default 5 min)
MEDIA_VERIFY_EBOOK_OBJECT=true       # HEAD-check the ebook PDF exists before signing (404 "not available" if missing); set false to skip

# ─── MySQL / Prisma (sole datastore — MongoDB has been fully removed) ────────
MYSQL_ROOT_PASSWORD=websankul_dev
# PRODUCTION: `connection_limit` is REQUIRED, not optional. Prisma defaults to
# (num_cpus * 2 + 1) connections PER PROCESS. Under PM2 cluster that multiplies by
# API_INSTANCES + the worker, and MySQL's default max_connections is only 151 — so
# an 8-core box running 8 API instances would try to open ~150 connections and the
# next query (typically an admin report) dies with "too many connections".
#
#   connection_limit = floor(max_connections * 0.8 / (API_INSTANCES + 1))
#
# e.g. max_connections=151, API_INSTANCES=2  ->  151*0.8/3  ->  connection_limit=40
#      max_connections=151, API_INSTANCES=8  ->  151*0.8/9  ->  connection_limit=13
#
# Check the server's ceiling with:  SHOW VARIABLES LIKE 'max_connections';
# Watch actual usage under load with: SHOW STATUS LIKE 'Threads_connected';
# Also consider pool_timeout (seconds a query waits for a free connection, default 10).
# Example: mysql://user:pass@host:3306/db?connection_limit=40&pool_timeout=20
DATABASE_URL=mysql://root:websankul_dev@127.0.0.1:3307/websankul_staging

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ─── Async report exports (POST /admin/exports) ──────────────────────────────
# Optional. How long a generated export file (+ its signed download URL) stays
# valid before the retention GC deletes it. Defaults if unset.
# EXPORT_RETENTION_MINUTES=45
# EXPORT_SIGNED_URL_TTL_SECONDS=900

# ─── Request body limits ─────────────────────────────────────────────────────
# Ceiling for PARSED bodies (JSON + urlencoded). Keep small: large uploads never
# reach these parsers — ebook PDFs go direct-to-Spaces via /admin/uploads/presign
# and multipart is streamed by multer. A high limit lets one request allocate the
# whole amount and blocks the event loop while JSON.parse runs. Default 1mb.
# BODY_LIMIT=1mb
# Ceiling for the bulk question-import route only (/admin/quizzes/questions/bulk),
# which is the one legitimately-large JSON payload. Default 25mb.
# BULK_BODY_LIMIT=25mb

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Temporary kill-switch. true = disable ALL rate limiters (testing/QA only).
# Leave unset / false in production (weakens anti-DDoS + OTP anti-spam).
# RATE_LIMIT_DISABLED=false
# Client (mobile/web): per-user when Bearer token present, else per-IP. Default 300/min.
# RATE_LIMIT_CLIENT_MAX=300
# Educator/promoter surfaces: per-IP. Default 120/min.
# RATE_LIMIT_GLOBAL_MAX=120
# REDIS_PASSWORD=          # required when Redis auth is enabled (production)

# ─── PM2 process topology (production) ───────────────────────────────────────
# websankul-api:    WORKER_ENABLED=false  HTTP_SERVER_ENABLED=true  (default in ecosystem.config.cjs)
# websankul-worker: WORKER_ENABLED=true   HTTP_SERVER_ENABLED=false
# DEPLOY_PROFILE=api|worker  — used by env validation warnings at boot

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=info             # set in PM2 env_production; debug in dev

# ─── Admin RBAC enforcement ──────────────────────────────────────────────────
# Per-endpoint admin permission enforcement (see rbac-module-visibility.md §4).
# Unset / false  = SHADOW MODE (default): callers missing a permission key are
#                  logged ("would-block") but NOT denied — verify grants from
#                  logs before turning on. Zero lock-out risk.
# true           = ENFORCE MODE: missing key ⇒ 403 { success:false, "Forbidden" }.
# Super-admins always bypass.
# RBAC_ENFORCE=false

ENV=DEV
ORIGIN=http://localhost:4000

# ─── Deep linking / share redirects ─────────────────────────────────────────
# Custom URL scheme the mobile app registers. Used to build notification
# deep-links (com.gpscvideo.gpsc://course/42) and share-redirect app links.
# Optional — defaults to com.gpscvideo.gpsc.
# APP_SCHEME=com.gpscvideo.gpsc

# ─── App version check (GET /api/v1/client/app-version/check) ────────────────
# iOS latest version is read LIVE from Apple's iTunes Lookup API. Set either the
# bundle id (preferred) or the numeric App Store id. Android has no official
# version API, so its "latest" is taken from the admin-configured version rows.
# All optional: unset iOS keys -> the check degrades to admin config for iOS too.
# IOS_BUNDLE_ID=com.gpscvideo.gpsc
# IOS_APP_STORE_ID=123456789
# IOS_APP_STORE_URL=https://apps.apple.com/in/app/id123456789
# ANDROID_PACKAGE_NAME=com.gpscvideo.gpsc
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.gpscvideo.gpsc
# APP_STORE_COUNTRY=in     # 2-letter store storefront for the iTunes lookup (default: in)

# ─── Production-required (NODE_ENV=production / pm2 --env production) ─────
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
RAZORPAY_WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret
# RAZORPAY_PAYOUT_WEBHOOK_SECRET=...
# METRICS_TOKEN=...              # if /metrics is exposed

# ─── Migration API tests (docs/migration/api-tests) ─────────────────────────
# MIGRATION_API_BASE_URL=http://localhost:4001
# MIGRATION_TEST_ADMIN_EMAIL=admin@example.com
# MIGRATION_TEST_ADMIN_PASSWORD=your-password
# MIGRATION_TEST_CUSTOMER_PHONE=9999999999
# MIGRATION_TEST_CUSTOMER_OTP=5786
# MIGRATION_API_SKIP_WRITE=true   # set to skip PUT/POST/DELETE tests (default: run writes + revert)

# ─── 5xx error message exposure ──────────────────────────────────────────────
# Both OPTIONAL. Default (both unset) = the safe production behaviour: any 5xx
# whose `message` looks like an internal string (Prisma invocation, stack frame,
# file path, ECONN*, ER_*, TypeError, …) is replaced with "Internal Server Error"
# before it leaves the process. The raw text is still written to the logs.
#
# EXPOSE_ERROR_DETAILS=true   # local debugging only — send RAW 5xx messages to the client.
# STRICT_5XX_MESSAGES=true    # collapse EVERY 5xx message, including curated ones
#                             # like "Failed to list subscriptions.", to the generic sentence.

# ─── StreamOS (live streaming + recordings) ──────────────────────────────────
# StreamOS shipped a NEW API on a new host. Both clients ship side by side and
# are selected by STREAMOS_PROVIDER. See docs/migration/STREAMOS_V1_CHANGE_MATRIX.md
#
# STREAMOS_PROVIDER=legacy       # legacy (default) | v1 — which API NEW streams use.
#                                # Leave on legacy until the v1 cutover is verified:
#                                # existing sessions hold legacy stream ids + CDN URLs.
#
# --- legacy API (streamapi.streamos.co) ---
# STREAMOS_ACCESS_KEY=...
# STREAMOS_ACCESS_SECRET=...
# STREAMOS_WEBHOOK_SECRET=...    # our own shared secret, sent back as ?key= (legacy only)
#
# --- v1 API (api.streamos.in) ---
# STREAMOS_API_BASE=https://api.streamos.in/api/public/v1   # override only if they move it
# STREAMOS_API_KEY=sk_live_...                              # one active key per org
# STREAMOS_WEBHOOK_SIGNING_SECRET=...                       # returned ONCE by POST /webhooks/
#
# STREAMOS_ENV_TAG=production    # which deployment this is. StreamOS confirmed staging
#                                # and prod SHARE one organisation + one API key, so both
#                                # environments' streams sit in the same StreamOS account
#                                # and one webhook can receive the other's recordings.
#                                # Stamped on every stream we create; the webhook handler
#                                # ignores deliveries tagged with a different value.
#                                # MUST differ between staging and prod. Defaults to NODE_ENV.

# Copy remaining keys (SMTP, Razorpay, DO Spaces, Firebase, METRICS_TOKEN, etc.) from your existing .env as needed.
